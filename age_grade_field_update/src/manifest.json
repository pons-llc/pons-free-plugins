{
  "$schema": "https://raw.githubusercontent.com/kintone/js-sdk/%40kintone/plugin-manifest-validator%4010.2.0/packages/plugin-manifest-validator/manifest-schema.json",
  "manifest_version": 1,
  "version": 1,
  "type": "APP",
  "desktop": {
    "js": [
      "js/lib/cursor-enumerator.js",
      "js/lib/batch-writer.js",
      "js/lib/current-value-formatter.js",
      "js/lib/build-confirm-message.js",
      "js/lib/config-store.js",
      "js/bulk-update.js",
      "js/desktop.js"
    ],
    "css": [
      "css/51-modern-default.css",
      "css/desktop.css"
    ]
  },
  "icon": "image/icon.png",
  "config": {
    "html": "html/config.html",
    "js": [
      "js/lib/config-store.js",
      "js/lib/config-validation.js",
      "js/config.js"
    ],
    "css": [
      "css/51-modern-default.css",
      "css/config.css"
    ],
    "required_params": []
  },
  "name": {
    "en": "age_grade_field_update plugin",
    "ja": "年齢・学年フィールド計算用フィールド更新プラグイン"
  },
  "description": {
    "en": "Adds a list-screen button (PC and mobile) that bulk-writes the current date/datetime into a configured DATE/DATETIME field for matching records, keeping age/grade calculation fields fresh.",
    "ja": "年齢・学年をDATEDIF等で計算するCALCフィールドの「基準日」のような、定期的に今日の日付へ更新したいDATE/DATETIMEフィールドを、一覧画面(PC・モバイル)のボタン押下で対象レコード全件まとめて更新するプラグイン"
  },
  "mobile": {
    "js": [
      "js/lib/cursor-enumerator.js",
      "js/lib/batch-writer.js",
      "js/lib/current-value-formatter.js",
      "js/lib/build-confirm-message.js",
      "js/lib/config-store.js",
      "js/bulk-update.js",
      "js/mobile.js"
    ],
    "css": [
      "css/mobile.css"
    ]
  }
}

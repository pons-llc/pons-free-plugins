      "js/view-editor.js",
      "js/desktop.js"
    ],
    "css": ["css/desktop.css"]
  },
  "mobile": {
    "js": [
      "js/lib/option-changes.js",
      "js/lib/operations.js",
      "js/lib/target-fields.js",
      "js/lib/view-changes.js",
      "js/lib/query-url.js",
      "js/lib/change-request.js",
      "js/lib/api-path.js",
      "js/lib/deploy-poller.js",
      "js/lib/field-defs.js",

{
  "$schema": "https://raw.githubusercontent.com/kintone/js-sdk/%40kintone/plugin-manifest-validator%4010.2.0/packages/plugin-manifest-validator/manifest-schema.json",
  "manifest_version": 1,
  "version": 4,
  "type": "APP",
  "desktop": {
    "js": [
      "js/lib/mobile-url.js",
      "js/lib/panel-state.js",
      "js/lib/config-store.js",
      "js/desktop.js"
    ],
    "css": [
      "css/51-modern-default.css",
      "css/desktop.css"
    ]
  },
  "icon": "image/icon.png",
  "config": {
    "html": "html/config.html",
    "js": [
      "js/lib/config-store.js",
      "js/lib/config-validation.js",
      "js/config.js"
    ],
    "css": [
      "css/51-modern-default.css",
      "css/config.css"
    ],
    "required_params": []
  },
  "name": {
    "en": "sidebar_mobile_view plugin",
    "ja": "サイドパネルモバイル表示プラグイン"
  },
  "description": {
    "en": "sidebar_mobile_view plugin",
    "ja": "レコード詳細・編集・新規作成画面のサイドパネルに、コメント・変更履歴の代わりにモバイル版レコード画面(または別アプリのモバイル版一覧)をiframeで表示できるプラグイン(PC専用)。レコード画面上のボタンでいつでも切り替えられる。編集・新規作成画面のみ初期表示を設定できる(詳細画面は編集ボタン等と重ならないよう常に非表示から始まる)。"
  }
}
